# The Ninth Room, environment template.
# Copy to .env (gitignored) and fill in what you use. Every value is optional.

# Where per-episode work directories live. Defaults to <repo>/work.
WORK_DIR=~/Projects/the-ninth-room/work

# The Claude Code binary the dispatcher launches. Leave empty to use `claude`
# from PATH, then ~/.local/bin/claude.
NINTH_ROOM_CLAUDE_BIN=

# A folder synced to iCloud Drive where finished mp4s and caption files are
# dropped. Leave blank to skip.
ICLOUD_DROP_DIR=

# Transcription is local (faster-whisper). An OpenAI key is read only if the
# cloud path in pipeline/whisper_api.py is chosen explicitly.
# OPENAI_API_KEY=

# The Ninth Room — environment template
# Copy to .env (gitignored) and fill in real values.

# ── Stock asset providers (free APIs) ──────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Supabase (free tier project) ───────────────────────────────────
# After creating the project at https://supabase.com/dashboard,
# grab these from Project Settings → API.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Worker (local) ─────────────────────────────────────────────────
# Where per-video work dirs live. Absolute path on this Mac.
WORK_DIR=~/Projects/the-ninth-room/work

# Local FastAPI port the dashboard talks to.
WORKER_PORT=8787

# Shared secret between dashboard and worker (any random string).
WORKER_SECRET=

# ── Dashboard (Next.js) ────────────────────────────────────────────
# Public vars for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Allow-list email for single-user auth.
ALLOWED_EMAIL=

# ── Push-to-device (Phase 7) ───────────────────────────────────────
# Path on this Mac that's synced to iCloud Drive. Pipeline drops
# ready-to-post mp4s + caption .md here. Leave blank to skip.
ICLOUD_DROP_DIR=

# ── Deferred / monetization-gated (Phases 8+) ──────────────────────
# Uncomment when monetized; see ULTRA-PLAN section 8.5.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=
# FAL_KEY=

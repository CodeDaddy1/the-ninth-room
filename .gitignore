# Per-video work dirs — local source of truth, never committed
work/
worker/work/

# Env
.env
.env.local
.env.*.local

# macOS
.DS_Store

# Media outputs (regeneratable)
*.mp3
*.mp4
*.wav
*.m4a
*.mov

# Allow committed brand exports (logo / watermark PNGs)
!brand/exports/*.png


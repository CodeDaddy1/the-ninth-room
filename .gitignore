node_modules/
.next/
.turbo/
.vercel/
*.log
dist/
build/

# Supabase CLI scratch
supabase/.temp/
supabase/.branches/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# IDE
.idea/
.vscode/

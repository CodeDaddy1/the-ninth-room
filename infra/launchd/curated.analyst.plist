<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.curatedcuriosities.analyst</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>~/Projects/curated-curiosities/worker/cli.py</string>
        <string>analyst-weekly</string>
    </array>

    <key>WorkingDirectory</key>
    <string>~/Projects/curated-curiosities</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Mondays at 09:00 local. If the Mac is asleep, launchd fires at next wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>~/Library/Logs/curated-analyst.out.log</string>

    <key>StandardErrorPath</key>
    <string>~/Library/Logs/curated-analyst.err.log</string>
</dict>
</plist>
